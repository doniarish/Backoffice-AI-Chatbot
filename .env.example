# Backoffice AI Chatbot — Demo
# ================================
# Environment configuration template
# Copy to .env and fill in real values

# ── LLM Configuration ──────────────────────────────────────────────────────────
# Required for intent classification, RAG polishing, and Text-to-SQL generation.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM model to use (default: gpt-4o-mini for cost efficiency)
LLM_MODEL=gpt-4o-mini

# Sampling temperature: 0.0 = deterministic (best for SQL), 0.7 = creative
LLM_TEMPERATURE=0.0

# Maximum tokens in LLM response
LLM_MAX_TOKENS=1024

# ── Redis Configuration (Optional) ─────────────────────────────────────────────
# If not set, the app automatically uses an in-memory session store.
# For local Redis: redis://localhost:6379/0
# For Redis Cloud: redis://username:password@host:port/db
REDIS_URL=

# ── Application Settings ────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

